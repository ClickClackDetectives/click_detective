# click_detective 서버 설정
# 이 파일은 click_detective/.env 위치에서 읽습니다. 변경 후 서버를 재시작하세요.
# 우선순위: 코드 직접 지정 > 프로세스 환경변수 > .env > config.py 기본값

# Next.js 서버가 사용할 비밀 키. 브라우저 코드나 NEXT_PUBLIC_ 변수에 넣지 마세요.
CLICK_API_KEY=replace-with-a-long-random-service-key

# local: 실제 NF4 양자화 모델 / fixture: GPU 없는 원문 조립 테스트
CLICK_GENERATION_MODE=local

# 경로는 click_detective 기준입니다. 모델과 학습된 어댑터를 각각 복사하세요.
CLICK_LOCAL_MODEL_PATH=./models/Qwen2.5-7B-Instruct
CLICK_LOCAL_MODEL_VERSION=Qwen2.5-7B-Instruct-nf4
CLICK_LORA_ADAPTER_PATH=./adapters/best_adapter
CLICK_ADAPTER_VERSION=provided-adapter

# 대사 생성은 평문, 의미 검증은 내부 JSON 계약을 사용합니다.
CLICK_GENERATION_OUTPUT_FORMAT=text
CLICK_MAX_INPUT_TOKENS=2048
CLICK_MAX_NEW_TOKENS=512
CLICK_HISTORY_LIMIT=6
CLICK_TIMEOUT_SECONDS=90
CLICK_GENERATION_ATTEMPTS=2
CLICK_VERIFICATION_ATTEMPTS=2
CLICK_VERIFICATION_BATCH_SIZE=10
CLICK_FALLBACK_ON_ERROR=true

# 자유 질문은 E5 벡터로 공개 가능 진술을 검색합니다.
# local 기본 모델 경로는 models/retrieval입니다. fixture에서 벡터 검색을 쓰려면 아래 경로를 지정하세요.
# CLICK_RAG_EMBEDDING_DIR=./models/retrieval
CLICK_RAG_ENABLED=true
CLICK_RAG_TOP_K=3
CLICK_RAG_MIN_SCORE=0.8322
CLICK_RAG_BM25_ENABLED=true
CLICK_RAG_DENSE_WEIGHT=0.65
CLICK_RAG_RRF_K=40

# 원본 데이터·DB·진단 경로
CLICK_DATA_DIR=./data
CLICK_DATABASE_PATH=./.data/games.sqlite3
CLICK_DIAGNOSTICS_ENABLED=true
CLICK_DIAGNOSTICS_PATH=./.data/dialogue-traces.jsonl

# 대사 표현의 자유도. 검증 JSON은 항상 greedy로 실행합니다. 변경 후 재시작하세요.
CLICK_DIALOGUE_TEMPERATURE=0.65
CLICK_DIALOGUE_TOP_P=0.9
CLICK_DIALOGUE_REPETITION_PENALTY=1.05
